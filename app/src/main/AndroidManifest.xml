<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Saving a Photo-mode canvas to the gallery. API 29+ uses MediaStore and needs no
         permission, so this is scoped to the older releases that do. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- So we can see / target WhatsApp & Telegram on Android 11+ -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <intent>
            <action android:name="com.whatsapp.intent.action.ENABLE_STICKER_PACK" />
        </intent>
        <intent>
            <action android:name="org.telegram.messenger.CREATE_STICKER_PACK" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/webp" />
        </intent>
    </queries>

    <application
        android:name=".StickersBankApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StickersBank">

        <!-- Launch animation; opens MainActivity when it's done. configChanges so a rotation
             mid-animation doesn't restart it from the top. -->
        <!-- AdMob app id — set per build type in app/build.gradle (admobAppId). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.StickersBank.Starting"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.StickersBank"
            android:windowSoftInputMode="adjustResize" />

        <!-- Hidden admin panel (launched via long-press on the logo, PIN-gated) -->
        <activity
            android:name=".admin.AdminActivity"
            android:exported="false"
            android:label="Admin"
            android:theme="@style/Theme.StickersBank" />

        <!-- Shares single stickers to chat apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Serves sticker packs to WhatsApp -->
        <provider
            android:name=".export.StickerContentProvider"
            android:authorities="com.stickers.bank.stickercontentprovider"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />

    </application>

</manifest>
